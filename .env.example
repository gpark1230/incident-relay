# Copy this file to .env and fill in real values. Never commit .env.

# This service's own Postgres database (NOT IncidentDesk's)
DATABASE_URL=postgresql://incident_relay:incident_relay@localhost:5433/incident_relay

# Redis: used for the event queue (RQ), the read-through cache, and rate-limit counters
REDIS_URL=redis://localhost:6380/0

# Slack (or Discord) incoming webhook URL for sending notifications
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/PLACEHOLDER

# Base URL of IncidentDesk's public REST API, for the cached read-through proxy
INCIDENT_DESK_API_URL=http://localhost:8000

# Credentials for a dedicated IncidentDesk service account (created via
# IncidentDesk's own POST /auth/signup — default "viewer" role is enough,
# GET /incidents/{id} doesn't require anything higher).
INCIDENT_DESK_SERVICE_EMAIL=your-service-account@example.com
INCIDENT_DESK_SERVICE_PASSWORD=REPLACE_ME

# Rate limit: max notifications per recipient per window
RATE_LIMIT_MAX_TOKENS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Cache TTL for GET /incidents/{id} proxy, in seconds
CACHE_TTL_SECONDS=30
